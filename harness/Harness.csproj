<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Harness</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <VSDir Condition="'$(VSDir)' == ''">$(LOCALAPPDATA)\Programs\Optimum</VSDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(VSDir)\Lib\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VintagestoryAPI"><HintPath>$(VSDir)\VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VSDir)\Mods\VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VSDir)\Lib\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="..\src\TickAllocFix.csproj" />
  </ItemGroup>
</Project>
